{
  "name": "finance-manager-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "Servidor MCP para Finance Manager Suite",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "start:stdio": "node dist/src/index.js",
    "dev": "tsx src/server.ts",
    "dev:stdio": "tsx src/index.ts",
    "test": "tsx src/test-sse-client.ts",
    "test:stdio": "tsx src/test-client.ts",
    "test:sse": "tsx src/test-sse-client.ts",
    "test:sse:remote": "tsx src/test-sse-client.ts --url",
    "inspector": "npx @modelcontextprotocol/inspector node dist/src/index.js",
    "inspector:sse": "npx @modelcontextprotocol/inspector"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "finance"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5"
  }
}
